{
  "info": {
    "name": "Identity Management - Tasks 5 to 9",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userEmail", "value": "user@example.com" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "password", "value": "Password123" }
  ],
  "item": [
    {
      "name": "Task 5 - Registration",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"012345678\",\n  \"role\": \"user\"\n}"
            },
            "url": "{{baseUrl}}/register/userregister"
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"098765432\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/register/userregister"
          }
        },
        {
          "name": "Reject Duplicate Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"011111111\",\n  \"role\": \"user\"\n}"
            },
            "url": "{{baseUrl}}/register/userregister"
          }
        }
      ]
    },
    {
      "name": "Task 6 - Login",
      "item": [
        {
          "name": "Login User",
          "event": [{
            "listen": "test",
            "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('userToken', pm.response.json().token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Reject Invalid Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\",\n  \"role\": \"user\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Task 8 - Admin",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        { "name": "Search User by Email", "request": { "method": "GET", "url": "{{baseUrl}}/admin/searchuser?email={{userEmail}}" } },
        { "name": "Search User by Name", "request": { "method": "GET", "url": "{{baseUrl}}/admin/searchuser?name=Example%20User" } },
        { "name": "Search User - Not Found", "request": { "method": "GET", "url": "{{baseUrl}}/admin/searchuser?email=missing@example.com" } },
        { "name": "View All Users", "request": { "method": "GET", "url": "{{baseUrl}}/admin/viewalluser" } },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/deluser?email={{userEmail}}" } }
      ]
    },
    {
      "name": "Task 9 - User",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
      "item": [
        { "name": "View Profile", "request": { "method": "GET", "url": "{{baseUrl}}/user/viewprofile" } },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated User\",\n  \"phone\": \"099999999\"\n}" },
            "url": "{{baseUrl}}/user/updateprofile"
          }
        }
      ]
    }
  ]
}
